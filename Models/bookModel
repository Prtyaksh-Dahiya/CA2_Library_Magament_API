const mongoose=require('mongoose')

const BookSchema=mongoose.Schema(
    {
        title:{
            type:String,
            trim:true,
            required:true
        },
        author:{
            type:String,
            trim:true,
            required:true
        },
        category:{
            type:String,
            trim:true,
            required:false
        },
        status:{
            type:String,
            enum:["Available","Unavailable"],
            default:"Available"
        },
        createdAt:{
            type:Date,
            default:Date.now()
        }
    }
)
const Book=mongoose.model('Book',BookSchema)
module.exports=Book